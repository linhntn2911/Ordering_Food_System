rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == 'admin'
        && currentUser().data.status == 'active';
    }

    // Mirrors the public read rule of menu_items for nested documents.
    function isPubliclyVisibleItem(menuItemId) {
      let item = get(/databases/$(database)/documents/menu_items/$(menuItemId)).data;
      return item.isPublished == true && item.isCategoryPublished == true;
    }

    function validAdminOrderTransition(fromStatus, toStatus) {
      return (fromStatus == 'Pending'
          && (toStatus == 'Confirmed' || toStatus == 'Rejected'))
        || (fromStatus == 'Confirmed' && toStatus == 'Preparing')
        || (fromStatus == 'Preparing' && toStatus == 'OutForDelivery')
        || (fromStatus == 'OutForDelivery' && toStatus == 'Completed');
    }

    function validCustomerProfile(userId) {
      return owns(userId)
        && request.resource.data.keys().hasAll([
          'fullName', 'email', 'phone', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active'
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string;
    }

    function validAddress(userId) {
      return owns(userId)
        && request.resource.data.keys().hasAll([
          'userId', 'label', 'recipientName', 'phoneNumber',
          'streetAddress', 'isDefault', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'label', 'recipientName', 'phoneNumber',
          'streetAddress', 'ward', 'district', 'city', 'latitude',
          'longitude', 'placeId', 'locationProvider', 'routeDistanceKm',
          'isDefault', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.label is string
        && request.resource.data.recipientName is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.streetAddress is string
        && request.resource.data.isDefault is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['latitude'])
          || request.resource.data.latitude is number)
        && (!request.resource.data.keys().hasAny(['longitude'])
          || request.resource.data.longitude is number)
        && (!request.resource.data.keys().hasAny(['routeDistanceKm'])
          || (request.resource.data.routeDistanceKm is number
            && request.resource.data.routeDistanceKm >= 0));
    }

    // Customer review on its own completed order. The document id must be
    // `<uid>_<orderId>`, so one review per order is enforced by existence.
    // The order must be Completed and updated within the last 30 days.
    function validCustomerReview(reviewId) {
      let data = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(data.orderId)).data;
      return signedIn()
        && reviewId == request.auth.uid + '_' + data.orderId
        && data.keys().hasOnly([
          'customerId', 'orderId', 'menuItemIds', 'rating', 'comment',
          'imageUrls', 'isEdited', 'createdAt', 'updatedAt'
        ])
        && data.customerId == request.auth.uid
        && data.orderId is string
        && data.menuItemIds is list
        && data.menuItemIds.size() > 0
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() <= 500
        && (data.rating > 2 || data.comment.size() > 0)
        && data.imageUrls is list
        && data.imageUrls.size() <= 3
        && data.isEdited == false
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && order.customerId == request.auth.uid
        && order.orderStatus == 'Completed'
        && request.time < order.updatedAt + duration.value(30, 'd')
        && !exists(/databases/$(database)/documents/reviews/$(reviewId));
    }

    match /users/{userId} {
      allow create: if validCustomerProfile(userId);
      allow read: if true;
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'avatarUrl', 'updatedAt'
        ]);
      allow update, delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, delete: if owns(userId);
        allow create: if validAddress(userId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if validAddress(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }

      match /favorites/{menuItemId} {
        allow read, create, delete: if owns(userId);
        allow update: if false;
      }

      match /cart_items/{cartItemId} {
        allow read, create, update, delete: if owns(userId);
      }

      match /notifications/{notificationId} {
        allow read, delete: if owns(userId);
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead', 'readAt'
          ]);
        allow create: if isAdmin()
          && request.resource.data.keys().hasAll([
            'type', 'title', 'body', 'orderId', 'isRead', 'createdAt'
          ])
          && request.resource.data.type in ['order_status', 'promo', 'system']
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.orderId is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time;
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if owns(userId);
      }
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /menu_items/{menuItemId} {
      // Unavailable items stay readable so they can show a sold-out label.
      // isCategoryPublished mirrors the owning category because list queries
      // cannot read the category document.
      allow get, list: if isAdmin()
        || (resource.data.isPublished == true
          && resource.data.isCategoryPublished == true);
      allow create, update, delete: if isAdmin();

      // Public display copy of a review without customer or order
      // identifiers (specs/004-food-details/contracts/firestore_review_access.md).
      // Written by the owner right after the private review with the same id.
      match /reviews/{reviewId} {
        allow get, list: if isAdmin() || isPubliclyVisibleItem(menuItemId);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/reviews/$(reviewId))
          && get(/databases/$(database)/documents/reviews/$(reviewId)).data.customerId
            == request.auth.uid
          && get(/databases/$(database)/documents/reviews/$(reviewId)).data.menuItemIds
            .hasAny([menuItemId])
          && request.resource.data.rating
            == get(/databases/$(database)/documents/reviews/$(reviewId)).data.rating
          && request.resource.data.comment
            == get(/databases/$(database)/documents/reviews/$(reviewId)).data.comment
          && request.resource.data.keys().hasOnly([
            'rating', 'comment', 'imageUrls', 'isEdited',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.isEdited == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /restaurant_configs/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || isAdmin());

      // Customer checkout creates only its own initial COD order. Totals and
      // delivery values are validated again by the checkout repository before
      // this write; Admin can only move the order through approved states.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'orderCode', 'customerId', 'customerName', 'customerPhone',
          'deliveryAddress', 'totalAmount', 'subtotal', 'deliveryFee',
          'deliveryDistanceKm', 'paymentMethod', 'paymentStatus',
          'orderStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderStatus == 'Pending'
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.totalAmount is int
        && request.resource.data.subtotal is int
        && request.resource.data.deliveryFee is int
        && request.resource.data.deliveryDistanceKm is number
        && request.resource.data.deliveryDistanceKm >= 0
        && request.resource.data.deliveryDistanceKm <= 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'updatedAt', 'rejectionReason', 'completedAt'
        ])
        && validAdminOrderTransition(
          resource.data.orderStatus,
          request.resource.data.orderStatus
        )
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.get('completedAt', null) == resource.data.get('completedAt', null)
          || (request.resource.data.orderStatus == 'Completed'
            && request.resource.data.completedAt == request.time)
        )
        && (
          request.resource.data.orderStatus != 'Rejected'
          || (
            request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
          )
        );

      match /items/{orderItemId} {
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
              == request.auth.uid
            || isAdmin()
          );
        allow create: if signedIn()
          && getAfter(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.customerId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'menuItemId', 'name', 'imageUrl', 'basePrice', 'selectedSize',
            'selectedToppings', 'quantity', 'unitPrice', 'lineTotal',
            'note', 'reviewed'
          ])
          && request.resource.data.name is string
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.unitPrice is int
          && request.resource.data.lineTotal is int
          && request.resource.data.reviewed == false;
        allow update, delete: if false;
      }

      match /status_events/{eventId} {
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
              == request.auth.uid
            || isAdmin()
          );
        // Audit events are append-only and may only be created by the same
        // active Admin who atomically moves the parent order to that status.
        allow create: if isAdmin()
          && request.resource.data.keys().hasAll([
            'fromStatus', 'toStatus', 'actorId', 'actorRole', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'fromStatus', 'toStatus', 'actorId', 'actorRole', 'reason',
            'createdAt'
          ])
          && request.resource.data.fromStatus is string
          && request.resource.data.toStatus is string
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorRole == 'admin'
          && request.resource.data.createdAt == request.time
          && (!request.resource.data.keys().hasAny(['reason'])
            || request.resource.data.reason is string)
          && validAdminOrderTransition(
            request.resource.data.fromStatus,
            request.resource.data.toStatus
          )
          && get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.orderStatus == request.resource.data.fromStatus
          && getAfter(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.orderStatus == request.resource.data.toStatus;
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      // Private review with customer and order identifiers: owner and Admin.
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if validCustomerReview(reviewId);
      allow update, delete: if false;
    }

    match /email_otps/{otpId} {
      allow read, write: if false;
    }

    match /user_credentials/{userId} {
      allow read, write: if false;
    }

    match /registered_identities/{identityKey} {
      allow read, write: if true;
    }

    match /mail/{mailId} {
      allow create: if true;
    }


    function chatAccountActive() {
      return signedIn() && currentUser().data.status == 'active';
    }

    function chatOrder(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function chatParticipant(orderId) {
      return chatAccountActive()
        && (isAdmin() || chatOrder(orderId).customerId == request.auth.uid);
    }

    function chatOpen(orderId) {
      let order = chatOrder(orderId);
      let completedAt = order.get('completedAt', null);
      return !(order.orderStatus in ['Completed', 'Cancelled', 'Rejected'])
        || request.time < (completedAt != null ? completedAt : order.updatedAt)
          + duration.value(24, 'h');
    }

    function chatRole() {
      return isAdmin() ? 'admin' : 'customer';
    }

    function chatMessagePath(orderId, messageId) {
      return /databases/$(database)/documents/order_chats/$(orderId)/messages/$(messageId);
    }

    function validChatAdvance(orderId, chat) {
      let path = chatMessagePath(orderId, chat.lastMessageId);
      let message = getAfter(path).data;
      return !exists(path)
        && chat.lastMessageAt == request.time
        && chat.updatedAt == request.time
        && chat.lastSenderRole == chatRole()
        && chat.lastMessagePreview is string
        && chat.lastMessagePreview.size() <= 80
        && message.createdAt == request.time
        && message.senderId == request.auth.uid
        && message.senderRole == chat.lastSenderRole;
    }

    match /order_chats/{orderId} {
      allow get: if chatParticipant(orderId);
      allow list: if chatAccountActive()
        && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if chatParticipant(orderId) && chatOpen(orderId)
        && request.resource.data.keys().hasOnly([
          'orderId', 'orderCode', 'customerId', 'issueType', 'openedByRole',
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview', 'lastSenderRole',
          'unreadByAdmin', 'unreadByCustomer', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.orderCode == chatOrder(orderId).get('orderCode', orderId)
        && request.resource.data.customerId == chatOrder(orderId).customerId
        && request.resource.data.issueType in [
          'missingOrWrongItem', 'lateDelivery', 'foodQuality',
          'addressOrContact', 'codPayment', 'other'
        ]
        && request.resource.data.openedByRole == chatRole()
        && (chatRole() != 'admin' || request.resource.data.issueType == 'other')
        && request.resource.data.createdAt == request.time
        && request.resource.data.unreadByAdmin == (chatRole() == 'customer')
        && request.resource.data.unreadByCustomer == (chatRole() == 'admin')
        && validChatAdvance(orderId, request.resource.data);
      allow update: if chatParticipant(orderId) && (
        (chatRole() == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByAdmin'])
          && request.resource.data.unreadByAdmin == false)
        || (chatRole() == 'customer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByCustomer'])
          && request.resource.data.unreadByCustomer == false)
        || (chatOpen(orderId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageId', 'lastMessageAt', 'lastMessagePreview', 'lastSenderRole',
            'unreadByAdmin', 'unreadByCustomer', 'updatedAt'
          ])
          && (chatRole() == 'admin'
            ? request.resource.data.unreadByCustomer == true
              && request.resource.data.unreadByAdmin == resource.data.unreadByAdmin
            : request.resource.data.unreadByAdmin == true
              && request.resource.data.unreadByCustomer == resource.data.unreadByCustomer)
          && validChatAdvance(orderId, request.resource.data))
      );

      match /messages/{messageId} {
        function validAttachment(value, prefix) {
          return value is string && (value in [prefix + '0.jpg', prefix + '1.jpg', prefix + '2.jpg']
            || (value.size() <= 2048
              && value.matches('https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?([/?#][^[:space:]]*)?')));
        }

        function validMessage(message) {
          let prefix = 'order_chats/' + orderId + '/' + messageId + '/';
          let parent = getAfter(/databases/$(database)/documents/order_chats/$(orderId)).data;
          return message.keys().hasOnly(['senderId', 'senderRole', 'text', 'imagePaths', 'createdAt'])
            && message.senderId == request.auth.uid
            && message.senderRole == chatRole()
            && message.createdAt == request.time
            && message.text is string && message.text.size() <= 1000
            && message.imagePaths is list && message.imagePaths.size() <= 3
            && message.imagePaths.toSet().size() == message.imagePaths.size()
            && (message.imagePaths.size() < 1 || validAttachment(message.imagePaths[0], prefix))
            && (message.imagePaths.size() < 2 || validAttachment(message.imagePaths[1], prefix))
            && (message.imagePaths.size() < 3 || validAttachment(message.imagePaths[2], prefix))
            && (message.text.matches('(?s).*[^[:space:]].*') || message.imagePaths.size() > 0)
            && parent.lastMessageAt == request.time
            && parent.lastMessageId == messageId;
        }

        allow read: if chatParticipant(orderId);
        allow create: if chatParticipant(orderId) && chatOpen(orderId)
          && validMessage(request.resource.data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
